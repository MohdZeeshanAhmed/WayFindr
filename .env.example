# Safe for the browser: Supabase project URL and publishable/anon key only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SITE_URL=http://localhost:5173

# Server-side Supabase Edge Function secrets (set with `supabase secrets set`):
# SUPABASE_SERVICE_ROLE_KEY=never_expose_this_to_the_browser
# RESEND_API_KEY=optional_email_provider_secret
# NOTIFICATION_EMAIL=team@example.com